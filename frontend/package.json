{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost",
    "models": "node scripts/copy-models.mjs",
    "postinstall": "npm run models",
    "build": "npm run models && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
